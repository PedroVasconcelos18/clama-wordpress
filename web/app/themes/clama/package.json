{
  "name": "clama-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:blocks && npm run build:css",
    "build:css": "tailwindcss -i assets/css/app.css -o assets/css/app.build.css --minify",
    "build:blocks": "wp-scripts build --webpack-src-dir=src --output-path=assets/blocks",
    "dev:css": "tailwindcss -i assets/css/app.css -o assets/css/app.build.css --watch"
  },
  "devDependencies": {
    "@wordpress/scripts": "^34.0.0",
    "tailwindcss": "^3.4.17"
  }
}
