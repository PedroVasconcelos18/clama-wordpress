# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# Tema: dependências de build não vão para o repositório
web/app/themes/*/node_modules/

# Banco SQLite local. O arquivo E o banco inteiro — versionar seria commitar
# conteudo, usuarios e senhas de desenvolvimento a cada post criado.
# Em producao ele vive no volume do Railway, em /data/database/.
web/app/database/
