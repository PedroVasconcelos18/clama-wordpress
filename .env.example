# ─── Banco ───────────────────────────────────────────────────────────────────
# SQLite: o banco é um arquivo, não um serviço. Escolhido para não pagar um
# segundo serviço no Railway. Plugin `sqlite-database-integration`, que é
# feature plugin do time de Performance do WordPress e ainda está marcado
# "Under Development" — o trade-off está em config/plugins-aprovados.json.
DB_ENGINE='sqlite'

# 🔴 Em container, DB_DIR PRECISA apontar para dentro do volume. O padrão do
# plugin é web/app/database/, que vive na imagem: cada deploy subiria um site
# em branco, sem erro nenhum. Local pode deixar vazio.
#   Railway: DB_DIR='/data/database/'
# DB_DIR=''
# DB_FILE='.ht.sqlite'

# ─── Para voltar a MySQL/MariaDB ─────────────────────────────────────────────
# Troque DB_ENGINE acima para 'mysql' e preencha abaixo. MySQL 8.4 LTS ou
# MariaDB 11.4 LTS — MySQL 8.0 chegou ao EOL em abril/2026 e não é opção.
# É o caminho de saída se o SQLite apertar: a migração de dados usa
# `wp db export` no SQLite e import no MySQL.
# DB_NAME='clama_wp'
# DB_USER='clama'
# DB_PASSWORD='trocar'
# DB_HOST='127.0.0.1:3307'
# DATABASE_URL='mysql://usuario:senha@host:porta/banco'

# Prefixo default é `wp_`. Só mude se houver motivo.
# DB_PREFIX='wp_'

# `production` é o default do Bedrock quando WP_ENV não é definido.
# É WP_ENV que decide a indexação — `blog_public` do banco nunca é lido.
# Ver clama-docs/procedimento-promocao-staging-wordpress.md
WP_ENV='development'

# ⚠️ Em produção, WP_HOME é o caminho público servido pela Vercel,
# não o hostname da origem. O rewrite do `clama-frontend/vercel.json`
# entrega /blog/* para cá; se WP_HOME apontar para a origem, o
# WordPress emite URLs absolutas dela e vaza o hostname.
#   produção: WP_HOME='https://clama.me/blog'
WP_HOME='http://localhost:8080'

# ⚠️ WP_SITEURL termina em /wp e NÃO é igual a WP_HOME. No Bedrock o core
# vive em web/wp; igualando os dois, o WordPress emite /blog/wp-includes/
# e /blog/wp-admin/, que dão 404 — todo asset do core quebra e o admin some.
WP_SITEURL="${WP_HOME}/wp"

# Raiz da SPA — o tema linka /conta, /sobre, /privacidade e o fluxo de pedido
# atraves dela. Vazio = caminho absoluto de raiz, correto em producao porque o
# blog vive em /blog do mesmo dominio.
# ⚠️ Em desenvolvimento o WordPress E a raiz, entao esses links dao 404 do
# WordPress. Aponte para a SPA rodando se quiser testa-los.
#   producao:        CLAMA_APP_URL='https://clama.me'
#   desenvolvimento: CLAMA_APP_URL='http://localhost:5173'
# CLAMA_APP_URL=''

# WP_DEBUG_LOG='/caminho/para/debug.log'

# Gerar em https://roots.io/salts.html — valores distintos por ambiente.
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
